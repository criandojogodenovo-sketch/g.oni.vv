<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- F5.1-C/F5.2: hasCode="true" — EXCEÇÃO documentada
         (docs/SAF_EXCEPTION.md). NativeActivity não lança a janela de
         permissões nem reencaminha onActivityResult sem uma subclasse: a
         VvActivity lança ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION
         (All Files Access — F5.2) e reencaminha o resultado por JNI. -->
    <application
        android:label="G.One VV"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="vv.goni.VvActivity"
            android:label="G.One VV"
            android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <meta-data
                android:name="android.app.lib_name"
                android:value="goni_vv" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
