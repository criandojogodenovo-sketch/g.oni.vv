<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- F5.5 (fix C33 0.6.9): MANAGE_EXTERNAL_STORAGE DECLARADO — sem esta
         declaração o sistema NÃO TEM O QUE CONCEDER: a app não aparecia na
         lista "Acesso a todos os ficheiros" (enquanto o Godot aparecia
         "Permitida") e Environment.isExternalStorageManager() era sempre
         false — o fluxo diálogo → ACTION_MANAGE_APP_ALL_FILES_ACCESS_
         PERMISSION → toggle NUNCA podia conceder nada (docs/SAF_EXCEPTION.md
         — decisão Play Policy revista: declarar é permitido; se publicar na
         Play, justificar o uso ou migrar para SAF/MediaStore). A permissão
         NÃO é pedida no arranque: só via a janela de settings, quando o
         utilizador tenta importar/exportar. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- 0.8.11 — ÁUDIO: o GRAVAR do workspace usa o microfone (AudioRecord
         PCM16). Declarada (sem isto o sistema não tem o que conceder) mas
         NÃO pedida no arranque: o pedido runtime corre quando o dono toca
         GRAVAR pela 1ª vez (VvActivity.ensureMicPermission → diálogo do
         sistema); negada = gravação desligada com toast honesto, o resto
         da app segue. -->
    <uses-permission
        android:name="android.permission.RECORD_AUDIO" />

    <!-- F5.1-C/F5.2: hasCode="true" — EXCEÇÃO documentada
         (docs/SAF_EXCEPTION.md). NativeActivity não lança a janela de
         permissões nem reencaminha onActivityResult sem uma subclasse: a
         VvActivity lança ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION
         (All Files Access — F5.2) e reencaminha o resultado por JNI; e
         desde a F5.4 é ela que recebe o projeto escolhido no Gestor
         (extras) e o reencaminha por nativeOpenProject. -->
    <!-- 0.11-Y · Y-0 — ÍCONE DA APP (decisão do dono): o «G EM CHAMA» — o
         glifo 3D em chama âmbar de docs/iconegonevv.png (a fonte sem alpha:
         o fundo preto/tile extraído por luminância T0=40/T1=90 pelo
         scripts/y0_gen_icons.py). O adaptativo (Android 8+) compõe o fundo
         sólido #08080A (values/ic_launcher_background.xml) com o foreground
         mipmap-*/ic_launcher_foreground.png (zona segura 43 %); o legacy
         (Android 7-) é o composto quadrado + round (48/72/96/144/192) nas 5
         densidades. O ícone ANTERIOR (0.9.6.10 — o G com 4 setas âmbar
         #FFB020 + setas #ECECEE sobre grafite #0E0E10, vetores puros do
         scripts/gen_app_icon.py) vive no HISTÓRICO do repo: o
         docs/icon-gone-512.png fica intacto e o mesmo gone_logo.png
         (drawable-nodpi) continua a miniatura default dos cards e o header
         da tela de projetos. -->
    <application
        android:label="G.One VV"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- F5.4: ECRÃ INICIAL — Gestor de Projetos (estilo Godot). A lista
             vive em projects.json (app-private); o "+" escolhe a pasta de
             CADA projeto via SAF (ACTION_OPEN_DOCUMENT_TREE + permissão
             persistente). Projetos diferentes em pastas diferentes, sem
             All Files Access. -->
        <activity
            android:name="vv.goni.ProjectManagerActivity"
            android:label="G.One VV"
            android:screenOrientation="sensorLandscape"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Editor (NativeActivity). lib_name mantém-se AQUI (o framework
             dlopen'a esta activity); o System.loadLibrary REAL corre no
             static init da VvActivity (F5.4 — JNI_OnLoad só corre por
             loadLibrary; o dlopen do framework não o chama). -->
        <activity
            android:name="vv.goni.VvActivity"
            android:label="G.One VV"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <meta-data
                android:name="android.app.lib_name"
                android:value="goni_vv" />
        </activity>
    </application>
</manifest>
